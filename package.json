{
  "name": "@tsci/abse.gameboy-advance",
  "version": "0.0.39",
  "description": "Game Boy Advance circuit",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "bun checks/run-validated.ts",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "check:shorts": "tsci check shorts --mode gerber --layer all dist/index/circuit.json",
    "report:drc": "bun checks/report-drc.ts",
    "build:3aa": "GBA_AA_CELLS=3 bun checks/run-validated.ts",
    "build:4aa": "GBA_AA_CELLS=4 bun checks/run-validated.ts",
    "check:schematic": "bun checks/schematic-validation.ts"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "tscircuit": "0.0.2827",
    "typescript": "^5.9.3",
    "@tscircuit/eval": "0.0.1594",
    "@tscircuit/checks": "0.0.247",
    "@tscircuit/props": "0.0.698",
    "circuit-to-svg": "0.0.445",
    "bun": "1.4.2",
    "@flatten-js/core": "1.6.14"
  },
  "author": "abdolsalamallawlabi",
  "dependencies": {}
}
